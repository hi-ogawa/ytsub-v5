    {
      "tStartMs": 25714,
      "dDurationMs": 3907,
      "segs": [
        {
          "utf8": "Creo que estoy soñando despierta"
        }
      ]
    },
    {
      "tStartMs": 29621,
      "dDurationMs": 5976,
      "segs": [
        {
          "utf8": "Toda la noche, una y otra vez"
        }
      ]
    },
    {
      "tStartMs": 35597,
      "dDurationMs": 2609,
      "segs": [
        {
          "utf8": "Atajo hacia ti"
        }
      ]
    },
    {
      "tStartMs": 38206,
      "dDurationMs": 1794,
      "segs": [
        {
          "utf8": "Intento encontrarlo"
        }
      ]
    },
    {
      "tStartMs": 40000,
      "dDurationMs": 4759,
      "segs": [
        {
          "utf8": "Aún me envuelve la confusión"
        }
      ]
    },
    {
      "tStartMs": 44759,
      "dDurationMs": 2933,
      "segs": [
        {
          "utf8": "La vista en que me perdí"
        }
      ]
    },
    {
      "tStartMs": 47692,
      "dDurationMs": 2308,
      "segs": [
        {
          "utf8": "La estoy recorriendo otra vez"
        }
      ]
    },
    {
      "tStartMs": 50000,
      "dDurationMs": 2706,
      "segs": [
        {
          "utf8": "Dicen que un espacio se abrió"
        }
      ]
    },
    {
      "tStartMs": 52706,
      "dDurationMs": 5772,
      "segs": [
        {
          "utf8": "Cuando creí que todo terminó, ya volvió, yeah"
        }
      ]
    },
    {
      "tStartMs": 58478,
      "dDurationMs": 1797,
      "segs": [
        {
          "utf8": "Siempre en el mismo lugar"
        }
      ]
    },
    {
      "tStartMs": 60275,
      "dDurationMs": 3298,
      "segs": [
        {
          "utf8": "Pero en realidad quiero correr más"
        }
      ]
    },
    {
      "tStartMs": 63573,
      "dDurationMs": 3623,
      "segs": [
        {
          "utf8": "can’t stop it’s my world"
        }
      ]
    },
    {
      "tStartMs": 67196,
      "dDurationMs": 2804,
      "segs": [
        {
          "utf8": "sé que todo ya está decidido"
