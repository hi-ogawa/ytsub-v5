{
  "wireMagic": "pb3",
  "pens": [{}],
  "wsWinStyles": [{}],
  "wpWinPositions": [{}],
  "events": [
    {
      "tStartMs": 873,
      "dDurationMs": 2126,
      "segs": [
        {
          "utf8": "こんにちは、シオンです"
        }
      ]
    },
    {
      "tStartMs": 3269,
      "dDurationMs": 4706,
      "segs": [
        {
          "utf8": "今日は2月11日、水曜日です"
        }
      ]
    },
    {
      "tStartMs": 8519,
      "dDurationMs": 6062,
      "segs": [
        {
          "utf8": "今は映像サイン会を終えて\n映像日記を撮っています"
        }
      ]
    },
    {
      "tStartMs": 15280,
      "dDurationMs": 5674,
      "segs": [
        {
          "utf8": "久しぶりに映像日記でお話しする気がしますが\nみなさん、私に会いたかったですよね？"
        }
      ]
    },
    {
      "tStartMs": 21960,
      "dDurationMs": 1909,
      "segs": [
        {
          "utf8": "会いたかったって言ってください！"
        }
      ]
    },
    {
      "tStartMs": 25410,
      "dDurationMs": 6483,
      "segs": [
        {
          "utf8": "カムバックしてから初めての映像日記な気がしますが"
        }
      ]
    },
    {
      "tStartMs": 33399,
      "dDurationMs": 3099,
      "segs": [
        {
          "utf8": "最近、みなさんに話したいことがたくさんあります"
        }
      ]
    },
    {
      "tStartMs": 36690,
      "dDurationMs": 5753,
      "segs": [
        {
          "utf8": "この前 大田に行って\nパンツアーのSIGNALを撮ったじゃないですか"
        }
      ]
    },
    {
      "tStartMs": 42943,
      "dDurationMs": 5476,
      "segs": [
        {
          "utf8": "SIGNALの撮影で近場に行くことは多いんですが"
        }
      ]
    },
    {
      "tStartMs": 48421,
      "dDurationMs": 4933,
      "segs": [
        {
          "utf8": "大田まで行ったのは初めてで、すごく驚きました"
        }
      ]
    },
    {
      "tStartMs": 53773,
      "dDurationMs": 3432,
      "segs": [
        {
          "utf8": "スケジュール表に「大田パンツアー」って\n書いてあるのを見たときは"
        }
      ]
    },
    {
      "tStartMs": 57208,
      "dDurationMs": 12584,
      "segs": [
        {
          "utf8": "メンバーも私も、大田のパン屋さんのソウル支店を\n回るパン屋巡りだと思ってたんです"
        }
      ]
    },
    {
      "tStartMs": 70027,
      "dDurationMs": 7795,
      "segs": [
        {
          "utf8": "でも聖心堂にも、近くの美味しいお店にも行けて\nびっくりの連続だったSIGNAL撮影でした"
        }
      ]
    },
    {
      "tStartMs": 79119,
      "dDurationMs": 7278,
      "segs": [
        {
          "utf8": "シンウィーオンニもハヨンもすごく満足してて\n楽しんでくれてた撮影だったと思います"
        }
      ]
    },
    {
      "tStartMs": 87476,
      "dDurationMs": 6136,
      "segs": [
        {
          "utf8": "久しぶりに撮影で大田に行けて、本当にうれしかったです"
        }
      ]
    },
    {
      "tStartMs": 94089,
      "dDurationMs": 10911,
      "segs": [
        {
          "utf8": "大田の街を歩いていたら、タイトル曲でもない\n「Firework Diary」が流れてきたんです"
        }
      ]
    },
    {
      "tStartMs": 105085,
      "dDurationMs": 8228,
      "segs": [
        {
          "utf8": "コンビニの前で、急に\n「Firework Diary」のイントロが聞こえてきたんです"
        }
      ]
    },
    {
      "tStartMs": 113316,
      "dDurationMs": 7731,
      "segs": [
        {
          "utf8": "その瞬間、「え、なに？」って本当にびっくりしたけど\nすごくありがたかったです"
        }
      ]
    },
    {
      "tStartMs": 121050,
      "dDurationMs": 4742,
      "segs": [
        {
          "utf8": "本当にこれは運命だって思いました、最高！"
        }
      ]
    },
    {
      "tStartMs": 126692,
      "dDurationMs": 8308,
      "segs": [
        {
          "utf8": "それから、前にやったパンのライブ配信も\nすごく意味のある時間でした"
        }
      ]
    },
    {
      "tStartMs": 135625,
      "dDurationMs": 5683,
      "segs": [
        {
          "utf8": "最近、パン関連のコンテンツをたくさん撮って\n不思議な気分です"
        }
      ]
    },
    {
      "tStartMs": 141612,
      "dDurationMs": 8605,
      "segs": [
        {
          "utf8": "自分がパク・シオンなのか\nパン・シオンなのか分からなくなるくらいでした"
        }
      ]
    },
    {
      "tStartMs": 150383,
      "dDurationMs": 4195,
      "segs": [
        {
          "utf8": "それから最近はコンサートの準備も一生懸命しています"
        }
      ]
    },
    {
      "tStartMs": 154967,
      "dDurationMs": 7892,
      "segs": [
        {
          "utf8": "メンバーも言ってたように\n今回のコンサートのセットリストは今までとは少し違います"
        }
      ]
    },
    {
      "tStartMs": 162862,
      "dDurationMs": 6229,
      "segs": [
        {
          "utf8": "その分、より充実した内容で準備してるので\n楽しみにしててくださいね"
        }
      ]
    },
    {
      "tStartMs": 169229,
      "dDurationMs": 9983,
      "segs": [
        {
          "utf8": "WAVがすごく楽しみにしてくれてると思いますが\nその期待に応えられるように頑張ります"
        }
      ]
    },
    {
      "tStartMs": 182296,
      "dDurationMs": 8856,
      "segs": [
        {
          "utf8": "行き帰りの移動もちゃんと安全に気をつけますので"
        }
      ]
    },
    {
      "tStartMs": 191374,
      "dDurationMs": 4268,
      "segs": [
        {
          "utf8": "WAVのみなさんも気をつけてくださいね"
        }
      ]
    },
    {
      "tStartMs": 195642,
      "dDurationMs": 6708,
      "segs": [
        {
          "utf8": "最近すごく寒いので、風邪やインフルエンザにも\n気をつけてくださいね、分かりましたか？"
        }
      ]
    },
    {
      "tStartMs": 203864,
      "dDurationMs": 11496,
      "segs": [
        {
          "utf8": "それから、久しぶりに\nmoonユニットで練習してて、とても新鮮で楽しいです"
        }
      ]
    },
    {
      "tStartMs": 215478,
      "dDurationMs": 5281,
      "segs": [
        {
          "utf8": "moonユニットには\n変なところで面白いメンバーが集まってるんです"
        }
      ]
    },
    {
      "tStartMs": 221079,
      "dDurationMs": 6927,
      "segs": [
        {
          "utf8": "だから、そのケミを\nWAVに見せられないのがちょっと残念です"
        }
      ]
    },
    {
      "tStartMs": 228009,
      "dDurationMs": 2532,
      "segs": [
        {
          "utf8": "WAVも知ってると思いますが"
        }
      ]
    },
    {
      "tStartMs": 230543,
      "dDurationMs": 5567,
      "segs": [
        {
          "utf8": "練習室に「WAVも一緒にいたらいいのに」と思うことが多いです"
        }
      ]
    },
    {
      "tStartMs": 237434,
      "dDurationMs": 3623,
      "segs": [
        {
          "utf8": "コンサートの準備をしてますが"
        }
      ]
    },
    {
      "tStartMs": 241060,
      "dDurationMs": 4043,
      "segs": [
        {
          "utf8": "準備を始めた頃は\nやることが多すぎて、不安もありました"
        }
      ]
    },
    {
      "tStartMs": 245494,
      "dDurationMs": 9160,
      "segs": [
        {
          "utf8": "できるだけ最高の状態まで持っていって\n素敵なステージをお見せしたいです"
        }
      ]
    },
    {
      "tStartMs": 255720,
      "dDurationMs": 4807,
      "segs": [
        {
          "utf8": "WAVの大切な時間が無駄にならない公演にしたいです"
        }
      ]
    },
    {
      "tStartMs": 261695,
      "dDurationMs": 4633,
      "segs": [
        {
          "utf8": "それでは、今日の映像日記はここまでにしますね"
        }
      ]
    },
    {
      "tStartMs": 266932,
      "dDurationMs": 4773,
      "segs": [
        {
          "utf8": "見てくださったみなさん\n本当にありがとうございます、バイバイ！"
        }
      ]
    }
  ]
}
