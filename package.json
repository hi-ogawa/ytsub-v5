{
  "name": "zamak",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev": "vite -c vite.web.config.ts",
    "build": "vite -c vite.web.config.ts build",
    "preview": "vite -c vite.web.config.ts preview",
    "dev-ext": "DEV_EXT=1 node --watch --watch-path=./src scripts/dev-ext.ts",
    "build-ext": "vite build --config vite.ext.config.ts && cd dist/extension && zip -r ../extension.zip .",
    "dev-full": "pnpm run '/^(dev|dev-ext)$/'",
    "build-full": "pnpm build && pnpm build-ext",
    "tsc": "tsc -b",
    "lint": "vp fmt && knip --fix",
    "lint-check": "vp fmt --check && knip",
    "test": "vp test",
    "test-e2e": "playwright test --project=app",
    "test-e2e-ext": "playwright test --project=ext",
    "test-e2e-full": "playwright test",
    "test-youtube": "playwright test --config playwright.youtube.config.ts",
    "release": "wrangler deploy",
    "types": "wrangler types --no-include-runtime",
    "db:migrate": "CI=true wrangler d1 migrations apply DB --local",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate",
    "db:bootstrap": "pnpm db:reset && pnpm db:seed",
    "db:clear": "wrangler d1 execute DB --local --file scripts/db-clear.sql -y",
    "db:seed-gen": "node scripts/db-seed-gen.ts scripts/db-seed-json/*/import.json > scripts/db-seed.sql",
    "db:seed": "wrangler d1 execute DB --local --file scripts/db-seed.sql -y"
  },
  "dependencies": {
    "@orpc/client": "^1.13.9",
    "@orpc/server": "^1.13.9",
    "@orpc/tanstack-query": "^1.13.9",
    "@tanstack/react-query": "^5.91.3",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.1",
    "sonner": "^2.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.29.0",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/chrome": "^0.1.38",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "knip": "^6.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.0",
    "vite": "^8.0.1",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.13",
    "wrangler": "4.74.0"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
