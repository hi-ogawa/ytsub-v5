{
  "name": "zamak",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "dev-ext": "DEV_EXT=1 node --watch --watch-path=./src scripts/dev-ext.ts",
    "build-ext": "vite build --config vite.ext.config.ts && cd dist/extension && zip -r ../extension.zip .",
    "tsc": "tsc -b",
    "lint": "oxfmt",
    "lint-check": "oxfmt --check && knip",
    "test": "vitest",
    "test-e2e": "playwright test",
    "test-youtube": "playwright test --config playwright.youtube.config.ts",
    "test-ext": "playwright test --config playwright.ext.config.ts",
    "release": "wrangler deploy",
    "types": "wrangler types --no-include-runtime",
    "db:migrate": "CI=true wrangler d1 migrations apply DB --local",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate",
    "db:bootstrap": "pnpm db:reset && pnpm db:seed",
    "db:clear": "wrangler d1 execute DB --local --file scripts/db-clear.sql -y",
    "db:seed-gen": "node scripts/db-seed-gen.ts scripts/db-seed-json/*/import.json > scripts/db-seed.sql",
    "db:seed": "wrangler d1 execute DB --local --file scripts/db-seed.sql -y"
  },
  "dependencies": {
    "@orpc/client": "^1.13.6",
    "@orpc/server": "^1.13.6",
    "@orpc/tanstack-query": "^1.13.6",
    "@tanstack/react-query": "^5.90.21",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.25.6",
    "@cloudflare/workers-types": "^4.20260305.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.0-beta.0",
    "knip": "^5.85.0",
    "oxfmt": "^0.36.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "8.0.0-beta.18",
    "vitest": "^4.0.18",
    "wrangler": "^4.69.0"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "pnpm": {
    "overrides": {
      "vite": "$vite"
    }
  }
}
