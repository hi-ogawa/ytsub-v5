{
  "name": "zamak",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev": "vite -c vite.web.config.ts",
    "build": "vite -c vite.web.config.ts build",
    "preview": "vite -c vite.web.config.ts preview",
    "dev-ext": "DEV_EXT=1 node --watch --watch-path=./src scripts/dev-ext.ts",
    "build-ext": "vite build --config vite.ext.config.ts && cd dist/extension && zip -r ../extension.zip .",
    "dev-full": "pnpm run '/^(dev|dev-ext)$/'",
    "build-full": "pnpm build && pnpm build-ext",
    "generate-extension-key": "node scripts/generate-extension-key.ts",
    "tsc": "tsc -b",
    "lint": "vp check --fix && pnpm lint-dead-code",
    "lint-check": "vp check && pnpm lint-dead-code",
    "lint-dead-code": "fallow dead-code --unused-exports --unused-types",
    "test": "vitest",
    "test-e2e": "pnpm build-ext && playwright test",
    "test-e2e-trace": "E2E_TRACE=1 pnpm test-e2e",
    "test-youtube": "playwright test --config playwright.youtube.config.ts",
    "release": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "release-preview": "wrangler d1 migrations apply DB --remote --config wrangler.preview-migrations.jsonc && wrangler preview",
    "types": "wrangler types --no-include-runtime",
    "db:migrate": "CI=true wrangler d1 migrations apply DB --local",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate",
    "db:bootstrap": "pnpm db:reset && pnpm db:seed",
    "db:clear": "wrangler d1 execute DB --local --file scripts/db-clear.sql -y",
    "db:seed-gen": "node scripts/db-seed-gen.ts scripts/db-seed-json/*/import.json > scripts/db-seed.sql",
    "db:seed": "wrangler d1 execute DB --local --file scripts/db-seed.sql -y"
  },
  "dependencies": {
    "@orpc/client": "^1.16.4",
    "@orpc/server": "^1.16.4",
    "@orpc/tanstack-query": "^1.16.4",
    "@tanstack/react-query": "^5.108.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@hiogawa/playwright-trace-pack": "https://pkg.pr.new/hi-ogawa/playwright-trace-pack/@hiogawa/playwright-trace-pack@df95343",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fallow": "^3.45.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.2",
    "vite": "^8.3.8",
    "vite-plus": "^1.7.0",
    "vitest": "catalog:",
    "wrangler": "4.165.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
