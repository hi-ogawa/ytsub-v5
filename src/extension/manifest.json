{
  "manifest_version": 3,
  "name": "Zamak",
  "version": "0.1.0",
  "description": "Watch YouTube with dual-language subtitles side by side. Click to seek, auto-scroll, resizable panel.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
