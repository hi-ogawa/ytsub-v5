{
  "manifest_version": 3,
  "name": "ytsub",
  "version": "0.1.0",
  "description": "Import YouTube subtitles to ytsub",
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
