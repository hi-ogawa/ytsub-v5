{
  "manifest_version": 3,
  "name": "zamak",
  "version": "0.1.0",
  "description": "Dual-language subtitle viewer for YouTube — learn languages by watching videos with side-by-side captions, click-to-seek, and auto-scroll.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
