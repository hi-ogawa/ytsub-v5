{
  "manifest_version": 3,
  "name": "Zamak",
  "version": "0.2.0",
  "description": "Watch YouTube with dual-language subtitles side by side. Bookmark captions, view all bookmarks. For language learners.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["relay.js"],
      "run_at": "document_idle"
    }
  ]
}
