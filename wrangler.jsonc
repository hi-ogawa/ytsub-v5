{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ytsub-v5",
  "compatibility_date": "2026-03-03",
  "main": "./src/server/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    // dev only — use `wrangler secret put` for production
    // echo -n "dev" | openssl dgst -sha256 -hex
    "AUTH_PASSWORD_HASH": "ef260e9aa3c673af240d17a2660480361a8e081d1ffeca2a5ed0e3219fc18567",
    "AUTH_SECRET": "dev-secret-change-in-production",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ytsub-v5",
      "database_id": "local",
      "migrations_dir": "src/server/migrations",
    },
  ],
}
