// Lets `wrangler d1 migrations apply` reach the Preview staging database, which wrangler.jsonc binds only under `previews`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zamak-staging",
      "database_id": "<staging-database-id>",
      "migrations_dir": "src/server/migrations",
    },
  ],
}
